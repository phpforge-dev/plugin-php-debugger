{
  "id": "phpforge.php-debugger",
  "name": "PHP Debugger / Xdebug",
  "version": "1.1.0",
  "minIdeVersion": "0.2.19",
  "description": "PHP Debugger / Xdebug: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "debugStatus",
      "debugListen",
      "debugUnlisten",
      "debugConfig",
      "debugRun",
      "debugRunStop",
      "debugContinue",
      "debugPause",
      "debugStack",
      "debugContexts",
      "debugVariables",
      "debugProperty",
      "debugEval"
    ],
    "event": "debug-event",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-php-debugger",
        "sha256": "fd0657002cc3537273240906dff0835d144af30234f76906f2a9f623d59c5b6b"
      },
      "x86_64-linux": {
        "path": "bin/x86_64-linux/phpforge-php-debugger",
        "sha256": "718a1ceecf9e2e176a42fb19a8c2d9bb1abca0d89d38618ce5f8062f910707f7"
      },
      "x86_64-windows": {
        "path": "bin/x86_64-windows/phpforge-php-debugger.exe",
        "sha256": "70fc73e6b51459da0ea3a95081fee2c12742c8de26d0712ebc29a6d7551e3118"
      }
    }
  }
}
