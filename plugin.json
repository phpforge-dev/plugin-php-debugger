{
  "id": "phpforge.php-debugger",
  "name": "PHP Debugger / Xdebug",
  "version": "1.0.0",
  "minIdeVersion": "0.2.11",
  "description": "PHP Debugger / Xdebug: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "debugStatus",
      "debugListen",
      "debugUnlisten",
      "debugConfig",
      "debugRun",
      "debugRunStop",
      "debugContinue",
      "debugStack",
      "debugContexts",
      "debugVariables",
      "debugProperty",
      "debugEval"
    ],
    "event": "debug-event",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-php-debugger",
        "sha256": "32d65b7035bb8c1b0f8a96797636bd467ff418818b46f94c8d35e9d5a4da8b09"
      },
      "x86_64-linux": {
        "path": "bin/x86_64-linux/phpforge-php-debugger",
        "sha256": "8ee70825537e5fbc7ca91f9abc7c824829ab6291c1142ca5c2e7402ec86e9ebd"
      },
      "x86_64-windows": {
        "path": "bin/x86_64-windows/phpforge-php-debugger.exe",
        "sha256": "5362d86373ffc3b6a69797a7f3961a1dcd77369c57687d065fcb8e693f16cf49"
      }
    }
  }
}
